# --- App ---
APP_NAME=fitness-platform
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# --- Database ---
# Async driver (used by the FastAPI app)
DATABASE_URL=postgresql+asyncpg://fitness:fitness@postgres:5432/fitness
# Sync driver (used by Celery workers and Alembic)
DATABASE_URL_SYNC=postgresql+psycopg://fitness:fitness@postgres:5432/fitness

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173"]

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=100/minute
